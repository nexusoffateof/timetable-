# ─────────────────────────────────────────────────────────────────────────────
#  Скопируйте в .env.local и заполните. Файл .env в git не попадает — так и надо.
# ─────────────────────────────────────────────────────────────────────────────

# ── Этап 5: Supabase ─────────────────────────────────────────────────────────
# Эти два значения попадают в браузер. Это нормально и задумано так:
# anon-ключ ничего не открывает сам по себе, доступ ограничивают политики RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Этапы 6–7: бот и напоминания ─────────────────────────────────────────────
# Ниже — только серверные переменные. Префикса VITE_ у них быть не должно
# никогда: Vite подставляет такие значения прямо в бандл, и они окажутся
# в DevTools у любого посетителя.
#
# service_role обходит RLS и видит всю базу целиком.
# Токен бота даёт полный контроль над ботом.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Токен у @BotFather. Секрет вебхука придумайте сами — им Telegram
# подписывает запросы, чтобы /api/telegram не мог дёрнуть посторонний.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Ширина окна выборки в минутах. Должна быть чуть больше периода cron,
# иначе урок проскочит между запусками: cron раз в 5 минут — окно 6.
REMINDER_WINDOW_MINUTES=6

# Общий секрет для защиты cron-эндпоинта от посторонних вызовов.
CRON_SECRET=

# ── Чат в правом нижнем углу ─────────────────────────────────────────────────
# Помощник ходит в /api/chat — серверную функцию Vercel. Ключ живёт только там.
# Без него виджет честно скажет, что помощник не подключён, и не сломается.
ANTHROPIC_API_KEY=

# Имя бота без «@» — по нему собирается ссылка t.me. Это публичное значение,
# поэтому префикс VITE_ здесь уместен. Пока пусто — виджет покажет,
# что бот появится на шестом этапе.
VITE_TELEGRAM_BOT=
